# MongoDB Database Connection URL Template
# Replace with your actual local or cloud (MongoDB Atlas) connection string:
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/coffeeshop_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/coffeeshop_db
MONGODB_URL=mongodb://localhost:27017/coffeeshop_db

# Vite Client Exposed Variables
VITE_MONGODB_URI=mongodb://localhost:27017/coffeeshop_db
VITE_API_URL=http://localhost:5000/api

# Port Configuration
PORT=5000
